# ===============================================================
# CLOUDVAULT: Cloud-Based File Storage and Sharing System
# Firebase Configuration Environment Variables
# ===============================================================
# 1. Go to Firebase Console (https://console.firebase.google.com/)
# 2. Create a new Firebase project (e.g., "cloudvault-app")
# 3. Add a Web App to get your project credentials
# 4. Enable Authentication (Email/Password)
# 5. Enable Cloud Firestore database (Start in test mode or deploy firestore.rules)
# 6. Enable Cloud Storage (Deploy storage.rules)
# 7. Copy this file to `.env` in the root folder and paste your keys below:

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: Default Administrator email address
VITE_ADMIN_EMAIL=admin@cloudvault.com
